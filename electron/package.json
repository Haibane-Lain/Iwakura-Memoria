{
  "name": "iwakura-memoria-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell (sidecar) for Iwakura Memoria",
  "author": "Lain",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lain.iwakuramemoria",
    "productName": "Iwakura Memoria",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "../dist/electron",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../scripts/build/_bundle/server",
        "to": "server"
      },
      {
        "from": "../LanguageTool 6.9",
        "to": "languagetool"
      },
      {
        "from": "../_jre",
        "to": "jre"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Iwakura Memoria"
    }
  }
}
