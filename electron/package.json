{
  "name": "iwakura-memoria-shell",
  "version": "0.2.0",
  "private": true,
  "description": "Electron shell (sidecar) for Iwakura Memoria",
  "author": "Lain",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lain.iwakuramemoria",
    "productName": "Iwakura Memoria",
    "artifactName": "Iwakura-Memoria-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "lifecycle.js",
      "updater.js",
      "update-utils.js",
      "package.json"
    ],
    "directories": {
      "output": "../dist/electron",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Haibane-Lain/Iwakura-Memoria/releases/latest/download"
      }
    ],
    "extraResources": [
      {
        "from": "../scripts/build/_bundle/server",
        "to": "server"
      },
      {
        "from": "../LanguageTool 6.8",
        "to": "languagetool"
      },
      {
        "from": "../_jre",
        "to": "jre"
      },
      {
        "from": "../WordNet-3.0/dict",
        "to": "wordnet/dict"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Iwakura Memoria",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  }
}
